PORT=3000
AUTH_PATH=auth_info
# Em produção (Railway/Render/Fly/Docker/VPS) use HOSTNAME=0.0.0.0
HOSTNAME=0.0.0.0

# Railway só da vitrine: não inicia Baileys. NÃO use no localhost do admin.
# PUBLIC_ONLY=true

# Cookie de sessão do painel (string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Supabase (somente servidor — não exponha a service role no browser)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (geração de título, descrição e preço)
GEMINI_API_KEY=
# Model ID obrigatório na API (não confundir com "versão da chave"). Use `auto` para gemini-flash-latest.
# Liste os disponíveis: GET .../v1beta/models?key=SUA_CHAVE
GEMINI_MODEL=gemini-3.6-flash
# Opcional: fallback se o principal der 503/404 (ordem importa)
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash

# Dev local (Windows/antivírus com inspeção HTTPS): desativa verificação TLS.
# NUNCA use em produção.
# TLS_INSECURE_DEV=true
